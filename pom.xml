<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nitroboost</groupId>
    <artifactId>nitroboost</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>NITRO BOOST</name>
    <description>Aplicacao desktop para otimizacao e controle de performance do Windows 11</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Classe principal (JavaFX Application) -->
        <mainClass>com.nitroboost.Main</mainClass>
        <!--
            Classe de entrada do jar empacotado/jpackage (nao a Application em si -
            ver Javadoc de Launcher.java para o motivo: evita o erro "componentes de
            runtime do JavaFX nao encontrados" ao rodar via "java -jar"/jpackage fora
            do module-path).
        -->
        <launcherClass>com.nitroboost.Launcher</launcherClass>

        <!-- Versoes das dependencias -->
        <javafx.version>21.0.12</javafx.version>
        <oshi.version>7.4.1</oshi.version>
        <jna.version>5.19.1</jna.version>
        <sqlite.version>3.53.2.1</sqlite.version>
        <jackson.version>2.22.1</jackson.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- JavaFX: UI desktop -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- OSHI: informacoes de hardware/SO (CPU, RAM, processos, sensores) -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>${oshi.version}</version>
        </dependency>

        <!-- JNA: acesso nativo ao Windows quando OSHI/comandos nao cobrirem algo -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- SQLite JDBC: persistencia local (historico, backups, locks) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Jackson: leitura/escrita de knowledge-base.json e outras configuracoes -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JUnit 5: suite de testes automatizados (Fase 12 Parte B) - so em escopo de teste. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>nitroboost</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
                db/schema.sql fica junto de DatabaseManager.java (ver secao 3 da
                documentacao do projeto), mas precisa ir para o classpath para
                poder ser lido em runtime via getResourceAsStream. Por isso
                incluimos explicitamente arquivos .sql de src/main/java aqui.
            -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Compilador Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!--
                maven-jar-plugin: define o Main-Class do manifesto como o
                Launcher (nao a Application diretamente - ver launcherClass acima
                e o Javadoc de Launcher.java), para que "java -jar target/nitroboost.jar"
                funcione sozinho (usado pelo jpackage no empacotamento da Fase 6).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${launcherClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!--
                javafx-maven-plugin: resolve os artefatos nativos do JavaFX pelo
                classifier correto do SO automaticamente (evita configurar
                module-path / add-modules manualmente e baixar SDK JavaFX a parte).
                Uso: ./mvnw javafx:run
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>

            <!--
                exec-maven-plugin: permite rodar classes utilitarias de teste manual
                (ex: HardwareInfoPrinter, JnaTest) sem precisar abrir a janela JavaFX.
                Uso: ./mvnw exec:java -Dexec.mainClass=com.nitroboost.core.HardwareInfoPrinter
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>

            <!--
                maven-surefire-plugin: versao explicita compativel com JUnit 5 (o provider padrao
                de versoes antigas do Maven nao reconhece o motor Jupiter sem isso).
                Uso: ./mvnw test
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
                maven-dependency-plugin: copia todas as dependencias de runtime (incluindo
                os jars nativos do JavaFX com classifier "win", resolvidos automaticamente
                pelo perfil de SO do proprio POM do OpenJFX) para target/jpackage-input a
                cada "mvn package". O jpackage usa essa pasta (junto do nitroboost.jar
                principal) como classpath da aplicacao empacotada - ver secao "Empacotamento"
                do README.md e o script scripts/jpackage-build.bat.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-deps-for-jpackage</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
