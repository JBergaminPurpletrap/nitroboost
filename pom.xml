<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nitroboost</groupId>
    <artifactId>nitroboost</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>NITRO BOOST</name>
    <description>Aplicacao desktop para otimizacao e controle de performance do Windows 11</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Classe principal (JavaFX Application) -->
        <mainClass>com.nitroboost.Main</mainClass>

        <!-- Versoes das dependencias -->
        <javafx.version>21.0.12</javafx.version>
        <oshi.version>7.4.1</oshi.version>
        <jna.version>5.19.1</jna.version>
        <sqlite.version>3.53.2.1</sqlite.version>
        <jackson.version>2.22.1</jackson.version>
    </properties>

    <dependencies>
        <!-- JavaFX: UI desktop -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- OSHI: informacoes de hardware/SO (CPU, RAM, processos, sensores) -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>${oshi.version}</version>
        </dependency>

        <!-- JNA: acesso nativo ao Windows quando OSHI/comandos nao cobrirem algo -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- SQLite JDBC: persistencia local (historico, backups, locks) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Jackson: leitura/escrita de knowledge-base.json e outras configuracoes -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>nitroboost</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
                db/schema.sql fica junto de DatabaseManager.java (ver secao 3 da
                documentacao do projeto), mas precisa ir para o classpath para
                poder ser lido em runtime via getResourceAsStream. Por isso
                incluimos explicitamente arquivos .sql de src/main/java aqui.
            -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Compilador Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!--
                javafx-maven-plugin: resolve os artefatos nativos do JavaFX pelo
                classifier correto do SO automaticamente (evita configurar
                module-path / add-modules manualmente e baixar SDK JavaFX a parte).
                Uso: ./mvnw javafx:run
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>

            <!--
                exec-maven-plugin: permite rodar classes utilitarias de teste manual
                (ex: HardwareInfoPrinter, JnaTest) sem precisar abrir a janela JavaFX.
                Uso: ./mvnw exec:java -Dexec.mainClass=com.nitroboost.core.HardwareInfoPrinter
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>
        </plugins>
    </build>
</project>
